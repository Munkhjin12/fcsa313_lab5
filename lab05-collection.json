{
  "info": {
    "name": "Lab05 - Registration API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "T01 Happy path: идэвхтэй оюутан, урьдач хангана → OK",
      "item": [
        {
          "name": "Setup: идэвхтэй оюутан (CS201 үзсэн)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/students/S01_HAPPY",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "S01_HAPPY"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\",\n  \"coursesTaken\": [\n    \"CS201\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Setup: идэвхтэй оюутан (CS201 үзсэн) → 200\", function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup: CS201 урьдачтай хичээл",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses/C01_HAPPY",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "C01_HAPPY"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prerequisites\": [\n    \"CS201\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Setup: CS201 урьдачтай хичээл → 200\", function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Идэвхтэй оюутан урьдач хангахад бүртгэл амжилттай (OK)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentID\": \"S01_HAPPY\",\n  \"courseID\": \"C01_HAPPY\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", function () {",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "pm.test(\"result = OK\", function () {",
                  "  pm.expect(pm.response.json().result).to.eql(\"OK\");",
                  "});",
                  "pm.test(\"registrationID нь тоо\", function () {",
                  "  pm.expect(pm.response.json().registrationID).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
